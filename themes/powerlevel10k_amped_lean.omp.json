{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{ if .Env.SSH_CONNECTION }}{{ .HostName }}: {{ end }}{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "foreground": "darkGray",
"template": "{{ .Icon }}",
          "type": "os",
          "style": "plain",
          "properties": {
            "macos": "🍎",
            "linux": "🐧",
            "windows": "🪟",
            "raspbian": "🍓",
            "ubuntu": "🟠"
          }
        },
        {
          "foreground": "darkGray",
          "template": " {{ .UserName }} ",
          "type": "session",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_template": "{{ if or (eq .Shell \"bash\") (eq .Shell \"zsh\") }}/{{end}}",
            "max_depth": 2,
            "style": "agnoster_short"
          },
          "template": " 📁  {{ .Path }} ",
          "foreground": "lightBlue",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "branch_icon": "⌥ ",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} {{ .StashCount }}{{ end }} ",
          "foreground": "lightGreen",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}lightYellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}lightRed{{ end }}",
            "{{ if gt .Ahead 0 }}lightCyan{{ end }}",
            "{{ if gt .Behind 0 }}lightGreen{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " 🟣 {{ .Full }} ",
          "foreground": "lightBlue",
          "type": "dotnet",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " ☕ {{ .Full }} ",
          "foreground": "lightBlue",
          "type": "java",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " 🟢 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "lightGreen",
          "type": "node",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": " 🐍 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "lightYellow",
          "type": "python",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": " {{ if gt .Code 0 }}{{  reason .Code }}{{ else }}✓{{ end }} ",
          "leading_powerline_symbol": " ",
          "foreground": "darkGray",
          "type": "status",
          "style": "powerline",
          "foreground_templates": [
            "{{ if gt .Code 0 }}lightRed{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .Root }}<lightYellow> ϟ </>{{ end }}",
          "leading_powerline_symbol": " ",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " ⧖ {{ .FormattedMs }} ",
          "foreground": "lightYellow",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "3:04 PM"
          },
          "template": " ◷ {{ .CurrentDate | date .Format }} ",
          "foreground": "lightMagenta",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if eq .Shell \"cmd\" }}\\{{ else if eq .Shell \"pwsh\" }}>{{ else if eq .Shell \"zsh\" }}%{{ else }}#{{ end }} ",
          "foreground": "lightMagenta",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}

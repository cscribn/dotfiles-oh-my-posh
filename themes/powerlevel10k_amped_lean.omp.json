{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{ if .Env.SSH_CONNECTION }}{{ .HostName }}: {{ end }}{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "foreground": "darkGray",
          "type": "os",
          "style": "plain"
        },
        {
          "foreground": "darkGray",
          "template": "{{ .UserName }} ",
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "folder_separator_template": "{{ if or (eq .Shell \"bash\") (eq .Shell \"zsh\") }}/{{end}}",
            "max_depth": 2,
            "style": "agnoster_short"
          },
          "template": " \uf07c {{ .Path }} ",
          "foreground": "lightBlue",
          "type": "path",
          "style": "plain"
        },
        {
          "options": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "lightGreen",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}lightYellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}lightRed{{ end }}",
            "{{ if gt .Ahead 0 }}lightCyan{{ end }}",
            "{{ if gt .Behind 0 }}lightGreen{{ end }}"
          ]
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": " \ue77f {{ .Full }} ",
          "foreground": "lightBlue",
          "type": "dotnet",
          "style": "plain"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": " \ue738 {{ .Full }} ",
          "foreground": "lightBlue",
          "type": "java",
          "style": "plain"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "lightGreen",
          "type": "node",
          "style": "plain"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "lightYellow",
          "type": "python",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "foreground": "lightYellow",
          "type": "root",
          "style": "plain"
        },
        {
          "template": " \uf252 {{ .FormattedMs }} ",
          "foreground": "lightYellow",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }}{{  reason .Code }}{{ else }}✔{{ end }} ",
          "foreground": "darkGray",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}lightRed{{ end }}"
          ]
        },
        {
          "options": {
            "time_format": "3:04 PM"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "foreground": "lightMagenta",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "{{ if eq .Shell \"cmd\" }}\\{{ else if eq .Shell \"pwsh\" }}❯{{ else if eq .Shell \"zsh\" }}\uff05{{ else }}\uff04{{ end }} ",
          "foreground": "lightMagenta",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
